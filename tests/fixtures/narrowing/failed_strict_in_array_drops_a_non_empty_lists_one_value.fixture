// test: a failed strict in_array drops the one value every entry of a non-empty list is
// feature: hover
// expect_hover: $definite => string
// expect_absent: null
---
<?php

/** @param non-empty-list<null> $nulls */
function read(?string $doc, array $nulls): void
{
    if (!in_array($doc, $nulls, true)) {
        $definite = $doc;
        echo $defi<>nite;
    }
}
