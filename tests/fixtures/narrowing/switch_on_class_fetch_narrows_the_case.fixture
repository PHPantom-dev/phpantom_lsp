// test: a switch on $x::class narrows the subject inside the case
// feature: hover
// expect_hover: $narrowed => Alpha
// expect_absent: Beta
---
<?php

class Alpha { public function alphaOnly(): void {} }
class Beta { public function betaOnly(): void {} }

function check(Alpha|Beta $x): void
{
    switch ($x::class) {
        case Alpha::class:
            $narrowed = $x;
            echo $narr<>owed;
            break;
    }
}
