// test: an instanceof beside an unrelated operand in an || proves nothing about the subject
// feature: completion
// Adapted from phpactor if-statement/if_or.test, which narrows here.  Entering
// the branch says one of the operands held, and `true` on its own gets in
// without the instanceof ever being evaluated, so the subject is whatever it
// was on the way in.
// expect_absent: fooMethod(
---
<?php

class Foobar {
    public function fooMethod(): void {}
}

function test($foo): void {
    if ($foo instanceof Foobar || true || false or true or false) {
        $foo-><>
    }
}
