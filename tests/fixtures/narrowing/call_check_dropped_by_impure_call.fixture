// test: a call declared @phpstan-impure drops the check recorded through it
// feature: hover
// Proving `$stmt->fetch('id') !== false` says something about the row the
// statement is on.  `execute()` hands back a value, so nothing about its
// signature says it moves to another row — the tag is what does, and with
// it the recorded proof is stale again.
// expect: $row = array<string, string>|false
---
<?php

class Stmt {
    /** @return array<string, string>|false */
    public function fetch(string $key) { return false; }

    /** @phpstan-impure */
    public function execute(): bool { return true; }
}

function run(Stmt $stmt): void {
    if ($stmt->fetch('id') !== false) {
        $stmt->execute();
        $row = $stmt->fetch('id');
        echo $r<>ow;
    }
}
