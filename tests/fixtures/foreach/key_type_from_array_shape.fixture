// test: foreach key over an array shape is the union of the shape's keys
// feature: hover
// expect: $k = 'name'|'city'
// expect_absent: int|string
---
<?php

/** @param array{name: string, city: string} $row */
function f(array $row): void {
    foreach ($row as $k => $v) {
        $<>k;
    }
}
