// test: a loop writing at every key of a non-empty array leaves a non-empty array
// feature: hover
// expect: $out = non-empty-array<'dk'|'en', Translation>
---
<?php

class Translation {}

/** @param non-empty-array<'dk'|'en', string> $texts */
function f(array $texts): void {
    $out = [];
    foreach ($texts as $market => $text) {
        $out[$market] = new Translation();
    }
    $<>out;
}
