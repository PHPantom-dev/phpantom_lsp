// test: field run/??= may keep the value it had
// Ported from Tusk PHP (MIT), case "field run/??= may keep the value it had".
// php: 8.5
// feature: diagnostics
// expect_clean
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

function run(): void {
	$q = new Person();
	$q ??= new Logger();
	$q->name();
}
