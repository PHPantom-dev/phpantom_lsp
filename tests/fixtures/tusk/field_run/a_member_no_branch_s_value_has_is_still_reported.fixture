// test: field run/a member no branch's value has is still reported
// Ported from Tusk PHP (MIT), case "field run/a member no branch's value has is still reported".
// php: 8.5
// feature: diagnostics
// expect_code: unknown_member
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

function run(bool $c): void {
	$d = new Person();
	if ($c) {
$d = new Logger();
}
	$d->nope();
}
