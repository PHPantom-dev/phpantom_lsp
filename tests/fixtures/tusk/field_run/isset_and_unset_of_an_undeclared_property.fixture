// test: field run/isset and unset of an undeclared property
// Ported from Tusk PHP (MIT), case "field run/isset and unset of an undeclared property".
// php: 8.5
// feature: diagnostics
// expect_clean
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

class Customer {
	public function reset(): void {
		if (isset($this->subscribed)) {
			unset($this->subscribed);
		}
		echo $this->label ?? '';
	}
}
