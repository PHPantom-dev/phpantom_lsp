// test: field run/a variable assigned in several branches shows each one's type
// Ported from Tusk PHP (MIT), case "field run/a variable assigned in several branches shows each one's type".
// php: 8.5
// feature: hover
// PHPantom shows one hover block per possible value.
// expect: $x = Logger
// expect: $x = Person
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

function run(bool $c): void {
	$x = new Logger();
	if ($c) {
		$x = new Person();
	}
	echo $<>x->level;
}
