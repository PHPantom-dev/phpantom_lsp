// test: 8.1/new in initializer is clean
// Ported from Tusk PHP (MIT), case "8.1/new in initializer is clean".
// php: 8.5
// feature: diagnostics
// expect_clean
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

class Svc {
public function __construct(private Logger $log = new Logger()) {} function go(): Logger {
return $this->log;
}
}
