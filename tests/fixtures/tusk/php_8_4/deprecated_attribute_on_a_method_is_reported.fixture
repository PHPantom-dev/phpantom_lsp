// test: 8.4/deprecated attribute on a method is reported
// Ported from Tusk PHP (MIT), case "8.4/deprecated attribute on a method is reported".
// php: 8.5
// feature: diagnostics
// expect_code: deprecated_usage
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

class Svc {
#[\Deprecated] public function old(): void {} function go(): void {
$this->old();
}
}
