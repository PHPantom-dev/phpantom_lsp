// test: 8.0/throw expression after ?? is not unreachable
// Ported from Tusk PHP (MIT), case "8.0/throw expression after ?? is not unreachable".
// php: 8.5
// feature: diagnostics
// expect_clean
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

function run(?Logger $a): Logger {
$x = $a ?? throw new \RuntimeException('no');
return $x;
}
