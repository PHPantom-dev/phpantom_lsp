// test: 8.0/type survives a throw expression
// Ported from Tusk PHP (MIT), case "8.0/type survives a throw expression".
// php: 8.5
// feature: hover
// expect: info
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

function run(?Logger $a): void {
$x = $a ?? throw new \RuntimeException('no');
$x->in<>fo('x');
}
