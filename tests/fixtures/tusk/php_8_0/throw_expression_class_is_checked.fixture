// test: 8.0/throw expression class is checked
// Ported from Tusk PHP (MIT), case "8.0/throw expression class is checked".
// php: 8.5
// feature: diagnostics
// expect_code: unknown_class
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

function run(?Logger $a): Logger {
return $a ?? throw new Missing('no');
}
