<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

function run(): \Closure {
$f = fn () => throw new \RuntimeException('no');
return $f;
}
