// test: 8.3/typed constant is not named after its type
// Ported from Tusk PHP (MIT), case "8.3/typed constant is not named after its type".
// php: 8.5
// feature: hover
// expect: NAME
// expect: string
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

class Svc {
const string NAME = 'a';
}
function run(): void {
echo Svc::NA<>ME;
}
