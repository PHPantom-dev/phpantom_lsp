<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

function run(): int {
$d = \Time\Duration::fromMinutes(1)->add(\Time\Duration::fromSeconds(5));
$e = stream_last_errors();
return \clamp($d->seconds, 0, 60) + count($e) + (\SortDirection::Ascending === \SortDirection::Descending ? 1 : 0);
}
