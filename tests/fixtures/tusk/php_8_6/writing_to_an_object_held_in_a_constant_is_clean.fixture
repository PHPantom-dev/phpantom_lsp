// test: 8.6/writing to an object held in a constant is clean
// Ported from Tusk PHP (MIT), case "8.6/writing to an object held in a constant is clean".
// php: 8.6
// feature: diagnostics
// expect_clean
---
<?php
namespace App;

class Logger {
public function info(string $m): void {} public int $level = 0;
const LEVEL = 1;
}
interface Named {
public function name(): string;
}
interface Aged {
public function age(): int;
}
class Person implements Named, Aged {
	public function name(): string {
return '';
}
	public function age(): int {
return 0;
}
}

const DEFAULTS = new Logger();
function run(): void {
DEFAULTS->level = 3;
}
