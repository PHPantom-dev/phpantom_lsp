// test: a call that can throw before the assignment keeps the pre-try type in the catch
// feature: hover
// expect: null|'a'
---
<?php

function maybeThrows(): void {}

function test(): void {
    $path = null;

    try {
        maybeThrows();
        $path = 'a';
        throw new \RuntimeException('boom');
    } catch (\Throwable $e) {
        echo $<>path;
    }
}
