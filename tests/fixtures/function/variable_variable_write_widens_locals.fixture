// test: a write through a variable variable widens every local
// feature: hover
// `$$name` may name any local, so what the variables held before is gone.
// expect_hover: $rx => $rx = mixed
// expect_hover: $ry => $ry = mixed
---
<?php

function test(string $name): void {
    $x = 1;
    $y = 'a';
    $$name = 1;
    $rx = $x;
    $ry = $y;<>
}
