{#
/**
 * @file
 * Shows a greeting.
 *
 * Available variables:
 * - name: The name being greeted.
 * - greeting: The full greeting text.
 * - attributes: HTML attributes for the wrapper, including the class
 *   acme_theme adds in preprocess.
 */
#}
{# Try: go to the definition of 'acme.greeting' in path(), or of 'name' in the
   parameters after it, which lands on {name} in acme.routing.yml. #}
{# Try: go to the definition of 'acme/greeting' in attach_library(), which
   lands on its key in acme.libraries.yml, or complete a library name inside
   the quotes. #}
{{ attach_library('acme/greeting') }}
<p{{ attributes.addClass('acme-greeting') }} data-name="{{ name }}">{{ greeting }}</p>
<a href="{{ path('acme.greeting', {'name': 'World'}) }}">{{ 'Greet the world'|t }}</a>
